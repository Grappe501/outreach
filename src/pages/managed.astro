---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PartnerImage from '@/components/PartnerImage.astro';
---

<BaseLayout title="Managed Communications | Arkansas Campaign Data Cooperative" description="Full-service email at $0.015/contact and SMS at $0.028/text on the Electd stack for Arkansas campaigns.">
<section class="page-hero">
      <div class="section-inner">
        <p class="breadcrumb"><a href="/">Home</a> / Managed</p>
        <p class="brand-lockup">Managed / full-service</p>
        <h1 transition:name="page-title">We run the outreach. You stay focused on organizing.</h1>
        <p class="hero-lede">Full-service programs on <a href="https://www.electd.io/" rel="noopener noreferrer" target="_blank">Electd</a>—list prep, send ops, compliance basics, delivery coordination, and reporting.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/join/?intent=managed">Talk about managed service</a>
          <a class="btn btn-secondary" href="/pricing/">Compare rates</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <h2 >What’s included</h2>
        <ul class="feature-list two-col">
          <li>List building and segmentation</li>
          <li>Message and creative coordination</li>
          <li>Email, SMS, voice, and mail program management</li>
          <li>Compliance and delivery coordination</li>
          <li>Performance reporting</li>
          <li>Coordination with Electd, VAN, or your workflow</li>
        </ul>
      </div>
    </section>

    <section class="section section-platform">
      <div class="section-inner">
        <h2 >Full-service rates</h2>
        <div class="rate-table-wrap">
          <table class="rate-table">
            <thead>
              <tr><th scope="col">Channel</th><th scope="col">Managed full-service</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Email</th><td><span class="rate-num">$0.015</span> / contact (1.5¢)</td></tr>
              <tr><th scope="row">SMS</th><td><span class="rate-num">$0.028</span> / text (2.8¢)</td></tr>
              <tr><th scope="row">Voice</th><td><span class="rate-na">Electd <strong>$0.04</strong>/min + managed coordination</span></td></tr>
              <tr><th scope="row">Direct mail</th><td><span class="rate-na">Electd <strong>$0.70</strong>/mailer + managed list &amp; creative</span></td></tr>
            </tbody>
          </table>
        </div>
        <p class="rate-note">Self-serve Electd is <strong>$149/month</strong>. Pair with optional <a href="/data/">L2 data</a> via the <a href="/cooperative/">cooperative</a>.</p>
        <a class="btn btn-outline" href="/pricing/">Electd vs Managed table</a>
      </div>
    </section>

    <section class="section section-product">
      <div class="section-inner">
        <figure class="product-figure">
          <PartnerImage variant="electd-preview" loading="lazy" class="product-shot" />
          <figcaption>Managed programs run on <a href="https://www.electd.io/" rel="noopener noreferrer" target="_blank">Electd</a>.</figcaption>
        </figure>
        <a class="btn btn-primary" href="/join/?intent=managed">Request managed pricing</a>
      </div>
    </section>

</BaseLayout>

