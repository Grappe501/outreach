---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PartnerImage from '@/components/PartnerImage.astro';
import { pricingOfferCatalog } from '@/lib/schema';
---

<BaseLayout title="Rates — Electd vs Managed | Arkansas Campaign Data Cooperative" description="Electd $149/month plus quoted outreach rates vs managed full-service email and SMS for Arkansas campaigns." schemaExtra={[pricingOfferCatalog]}>
<section class="page-hero">
      <div class="section-inner">
        <p class="breadcrumb"><a href="/">Home</a> / Rates</p>
        <p class="brand-lockup">Quoted pricing</p>
        <h1 transition:name="page-title">Electd platform rates vs managed full-service.</h1>
        <p class="hero-lede">Self-serve on <a href="https://www.electd.io/" rel="noopener noreferrer" target="_blank">Electd</a>, or let us run full-service email and text on top of that stack. L2 data is a separate cooperative cost.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/join/?intent=platform">Get the platform</a>
          <a class="btn btn-secondary" href="/join/?intent=managed">Ask about managed</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="partner-row">
          <PartnerImage class="partner-logo" variant="electd-mark" loading="lazy" />
          <div>
            <h2 style="margin:0 0 0.35em">Platform subscription</h2>
            <p class="price-amount" style="margin:0 0 0.5em"><span>$149</span> per month</p>
            <ul class="price-notes">
              <li>No long-term contract — cancel anytime</li>
              <li>Includes Electd campaign platform access</li>
              <li>Voter data, list building, canvassing, phone banking, direct mail tools</li>
              <li>Outreach usage billed separately</li>
            </ul>
          </div>
        </div>
        <p><a href="/platform/">Electd details →</a> · <a href="https://www.electd.io/" rel="noopener noreferrer" target="_blank">electd.io</a></p>
      </div>
    </section>

    <section class="section section-platform">
      <div class="section-inner">
        <h2 >Channel rates</h2>
        <p class="rate-disclaimer"><strong>Platform column:</strong> quoted <a href="https://www.electd.io/" rel="noopener noreferrer" target="_blank">Electd</a> rates. <strong>Managed column:</strong> full-service programs we operate for you.</p>
        <div class="rate-table-wrap">
          <table class="rate-table">
            <thead>
              <tr>
                <th scope="col">Channel</th>
                <th scope="col">Electd / platform cost</th>
                <th scope="col">Managed full-service</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Email</th>
                <td><span class="rate-num">$0.0144</span> / verified email sent</td>
                <td><span class="rate-num">$0.015</span> / contact</td>
              </tr>
              <tr>
                <th scope="row">SMS</th>
                <td><span class="rate-num">$0.025</span> / verified text sent</td>
                <td><span class="rate-num">$0.028</span> / text</td>
              </tr>
              <tr>
                <th scope="row">Voice</th>
                <td><span class="rate-num">$0.04</span> / minute after connection</td>
                <td><span class="rate-na">Platform rate + managed coordination</span></td>
              </tr>
              <tr>
                <th scope="row">Direct mail</th>
                <td><span class="rate-num">$0.70</span> / mailer (print &amp; postage)</td>
                <td><span class="rate-na">$0.70 mailer + managed list &amp; creative</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="offer-grid" style="margin-top:2rem">
          <div class="offer-item">
            <h3>Electd / Platform</h3>
            <p class="offer-price">$149/mo + usage</p>
            <p>You build lists and send inside Electd.</p>
            <a class="btn btn-outline" href="/platform/">Platform details</a>
          </div>
          <div class="offer-item">
            <h3>Managed</h3>
            <p class="offer-price">Email $0.015 · SMS $0.028</p>
            <p>We handle list prep, sends, and delivery coordination.</p>
            <a class="btn btn-outline" href="/managed/">Managed details</a>
          </div>
        </div>
        <aside class="coop-aside">
          <h3>L2 Data Cooperative is separate</h3>
          <p>Enhanced statewide data from <a href="https://l2-data.com/" rel="noopener noreferrer" target="_blank">L2</a> is an optional one-time contribution—not included in $149. <a href="/cooperative/">See tiers →</a> · <a href="/data/">L2 overview →</a></p>
        </aside>
      </div>
    </section>

    <section class="section section-join">
      <div class="section-inner">
        <div class="join-intro">
          <p class="brand-lockup">Ready to talk numbers?</p>
          <h2 >Platform, managed, or both.</h2>
        </div>
        <div class="cta-row">
          <a class="btn btn-primary" href="/join/?intent=platform">Platform</a>
          <a class="btn btn-secondary" href="/join/?intent=managed">Managed</a>
          <a class="btn btn-ghost" href="/join/?intent=info">General information</a>
        </div>
      </div>
    </section>

</BaseLayout>

