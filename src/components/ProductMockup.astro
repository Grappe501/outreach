---
import { mockSteps } from '@/data/tour';

const first = mockSteps[0]!;
---

<figure class="product-mock" data-product-mock aria-label="Electd-style Arkansas campaign workflow preview">
  <div class="product-mock__chrome">
    <div class="product-mock__traffic" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <p class="product-mock__title">Arkansas HQ · Electd workspace</p>
  </div>

  <div class="product-mock__steps" role="tablist" aria-label="Workflow steps">
    {
      mockSteps.map((step, i) => (
        <button
          type="button"
          class:list={['product-mock__step', { 'is-active': i === 0 }]}
          role="tab"
          id={`mock-tab-${step.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="mock-panel"
          data-mock-step={step.id}
          data-step-index={i}
        >
          <span class="product-mock__step-num">{String(i + 1).padStart(2, '0')}</span>
          {step.label}
        </button>
      ))
    }
  </div>

  <div class="product-mock__body" id="mock-panel" role="tabpanel" aria-labelledby={`mock-tab-${first.id}`}>
    <aside class="product-mock__rail" aria-hidden="true">
      {['Lists', 'CRM', 'Outreach', 'Canvass', 'Reports'].map((item) => (
        <span class:list={{ 'is-active': item === first.rail }} data-mock-rail={item}>
          {item}
        </span>
      ))}
    </aside>

    <div class="product-mock__main">
      <div class="product-mock__ask">
        <span class="product-mock__ask-label">Ask Electd</span>
        <p class="product-mock__ask-query" data-ask-query>{first.ask}</p>
      </div>

      <div class="product-mock__panels">
        <div class="product-mock__voters">
          <div class="product-mock__panel-head">
            <strong data-mock-panel-title>Target universe</strong>
            <span data-voter-count>{first.count}</span>
          </div>
          <ul class="product-mock__voter-list" data-voter-list>
            {
              first.voters.map((v) => (
                <li>
                  <span class="dot" />
                  <span>{v.name}</span>
                  <em>{v.channels}</em>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="product-mock__feed">
          <div class="product-mock__panel-head">
            <strong>Activity</strong>
            <span>Live</span>
          </div>
          <ul class="product-mock__feed-list" data-activity-feed>
            {
              first.feed.map((f) => (
                <li>
                  <time>{f.time}</time> {f.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>

  <p class="product-mock__note" data-mock-note>{first.note}</p>
  <figcaption class="product-mock__caption">
    Illustrative Electd-style workflow for Arkansas campaigns — not a live login. Step through Ask → List → SMS → Canvass.
  </figcaption>

  <script is:inline type="application/json" data-mock-steps set:html={JSON.stringify(mockSteps)} />
</figure>
