---

<figure class="product-mock" aria-label="Electd-style campaign workspace preview">
  <div class="product-mock__chrome">
    <div class="product-mock__traffic" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <p class="product-mock__title">Arkansas HQ · Electd workspace</p>
  </div>

  <div class="product-mock__body">
    <aside class="product-mock__rail" aria-hidden="true">
      <span class="is-active">Lists</span>
      <span>CRM</span>
      <span>Outreach</span>
      <span>Canvass</span>
      <span>Reports</span>
    </aside>

    <div class="product-mock__main">
      <div class="product-mock__ask">
        <span class="product-mock__ask-label">Ask Electd</span>
        <p class="product-mock__ask-query" data-ask-query>
          Show persuadable Democrats in Pulaski with mobile numbers…
        </p>
      </div>

      <div class="product-mock__panels">
        <div class="product-mock__voters">
          <div class="product-mock__panel-head">
            <strong>Target universe</strong>
            <span data-voter-count>12,480</span>
          </div>
          <ul class="product-mock__voter-list" data-voter-list>
            <li>
              <span class="dot"></span>
              <span>Jordan M. · HD-32</span>
              <em>Mobile · Email</em>
            </li>
            <li>
              <span class="dot"></span>
              <span>Alex R. · Pulaski</span>
              <em>Mobile</em>
            </li>
            <li>
              <span class="dot"></span>
              <span>Casey T. · LR</span>
              <em>Email · Mail</em>
            </li>
            <li>
              <span class="dot"></span>
              <span>Morgan L. · NLR</span>
              <em>Mobile · Voice</em>
            </li>
          </ul>
        </div>

        <div class="product-mock__feed">
          <div class="product-mock__panel-head">
            <strong>Activity</strong>
            <span>Live</span>
          </div>
          <ul class="product-mock__feed-list" data-activity-feed>
            <li><time>now</time> SMS wave queued · 2,400</li>
            <li><time>2m</time> Canvass turf synced · Ward 2</li>
            <li><time>6m</time> Email open rate · 41%</li>
            <li><time>12m</time> New volunteer shift · 8</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <figcaption class="product-mock__caption">
    Illustrative Electd-style workspace for Arkansas campaigns — not a live login.
  </figcaption>
</figure>
