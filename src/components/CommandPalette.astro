---
import { navIndex } from '@/data/nav-index';

const groups = [...new Set(navIndex.map((item) => item.group))];
---

<div
  id="command-palette"
  class="cmdk"
  data-command-palette
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="cmdk-title"
>
  <div class="cmdk-backdrop" data-palette-close tabindex="-1"></div>
  <div class="cmdk-panel" role="document">
    <h2 id="cmdk-title" class="sr-only">Site search</h2>
    <label class="cmdk-label" for="cmdk-input">Jump to</label>
    <input
      id="cmdk-input"
      class="cmdk-input"
      type="search"
      placeholder="Search pages, rates, models, PDFs…"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      data-palette-input
    />
    <div class="cmdk-scroll" data-palette-list>
      {
        groups.map((group) => (
          <div class="cmdk-group" data-palette-group={group}>
            <p class="cmdk-group-label">{group}</p>
            <ul role="listbox" aria-label={group}>
              {navIndex
                .filter((item) => item.group === group)
                .map((item) => (
                  <li
                    role="option"
                    data-palette-item
                    data-href={item.href}
                    data-title={item.title}
                    data-keywords={item.keywords.join(' ')}
                    data-group={item.group}
                    aria-selected="false"
                    tabindex="-1"
                  >
                    <span class="cmdk-item-title">{item.title}</span>
                    <span class="cmdk-item-desc">{item.description}</span>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="cmdk-hint">
      <kbd>↑</kbd><kbd>↓</kbd> navigate · <kbd>Enter</kbd> open · <kbd>Esc</kbd> close
    </p>
  </div>
</div>
