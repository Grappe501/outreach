---
import { exploreGroups } from '@/data/nav';
---

{
  exploreGroups.map((group) => (
    <div class="explore-group">
      <p class="explore-group-label">{group.label}</p>
      <ul>
        {group.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  ))
}
