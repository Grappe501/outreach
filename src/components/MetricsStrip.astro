---
import { outcomeMetrics } from '@/data/offers';
---

<div class="metrics-strip" data-metrics-strip>
  <div class="metrics-strip__inner">
    {
      outcomeMetrics.map((metric) => (
        <div class="metrics-strip__item">
          <span class="metrics-strip__value">{metric.value}</span>
          <span class="metrics-strip__label">{metric.label}</span>
        </div>
      ))
    }
    <div class="metrics-strip__actions">
      <a href="#rate-calculator">Estimate cost</a>
      <a href="#compare">Compare options</a>
      <a href="#platform-tour">Platform tour</a>
    </div>
  </div>
</div>
