---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Subnav from '../components/Subnav.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { buildJsonLd, SITE, type PageSchemaInput } from '../lib/schema';
import '@fontsource/bricolage-grotesque/latin-500.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemaExtra?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, schemaExtra = [], ogImage } = Astro.props;
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname === '/'
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const slug =
  path === '/'
    ? 'home'
    : path.replace(/^\/|\/$/g, '').split('/')[0] || 'default';

const resolvedOg = ogImage ?? `/og/${slug}.png`;
const ogUrl = new URL(resolvedOg, SITE.url).toString();
const canonical = new URL(path, SITE.url).toString();
const jsonLd = buildJsonLd({
  title,
  description,
  path,
  schemaExtra,
} satisfies PageSchemaInput);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/assets/arkansas-logo.svg" as="image" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header currentPath={path} />
      <Subnav />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <CommandPalette />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
